# ==============================================================================
# 오카방가방가 (Okabang) 환경 변수 설정 템플릿 (.env.example)
# ==============================================================================
# 사용법:
#   1. 본 파일을 복사하여 .env (로컬 개발) 또는 .env.production (상용 배포) 생성
#      cp .env.example .env
#   2. 각 서비스 콘솔(Google Cloud, Kakao Developers, Notion 등)에서 발급받은 키 입력
#   3. 주의: 절대 실제 비밀키(Secret)를 GitHub 저장소에 커밋하지 마세요!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 애플리케이션 기본 설정 (Application Environment)
# ------------------------------------------------------------------------------
# 실행 모드: development | production | test
NODE_ENV="development"
VITE_APP_ENV="development"

# 서비스 기본 포트 (기본값: 3000)
PORT=3000

# 서비스 호스팅 URL (배포 환경의 도메인으로 설정)
# 예: https://okabang.kr 또는 Cloud Run / Vercel 도메인
APP_URL="https://ais-pre-ehqgt6tikwdwo43ottjsrv-966056115157.asia-east1.run.app"
VITE_APP_URL="https://ais-pre-ehqgt6tikwdwo43ottjsrv-966056115157.asia-east1.run.app"

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API 설정 (Core LLM Engine)
# ------------------------------------------------------------------------------
# Google AI Studio / Vertex AI에서 발급받은 Gemini API 키
# 발급처: https://aistudio.google.com/app/apikey
# 주의: 클라이언트 번들에 노출되지 않도록 서버 사이드 프록시 라우트에서만 사용
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 3. 카카오 오픈채팅 연동 설정 (Kakao Developers)
# ------------------------------------------------------------------------------
# 발급처: https://developers.kakao.com/
# 내 애플리케이션 > 앱 설정 > 요약 정보에서 확인

# [클라이언트 전용] 카카오 JavaScript 키 (카카오 로그인 팝업 및 SDK 초기화용)
VITE_KAKAO_JAVASCRIPT_KEY="your_kakao_javascript_key_here"

# [서버 전용] 카카오 REST API 키 (서버 간 토큰 교환 및 오픈채팅 웹훅 수신용)
KAKAO_REST_API_KEY="your_kakao_rest_api_key_here"

# [서버 전용] 카카오 Client Secret (보안 강화 시 활성화)
KAKAO_CLIENT_SECRET="your_kakao_client_secret_here"

# 카카오 OAuth Redirect URI
VITE_KAKAO_REDIRECT_URI="https://ais-pre-ehqgt6tikwdwo43ottjsrv-966056115157.asia-east1.run.app/oauth/kakao/callback"

# ------------------------------------------------------------------------------
# 4. 노션 워크스페이스 원클릭 연동 (Notion Integration API)
# ------------------------------------------------------------------------------
# 발급처: https://www.notion.so/my-integrations
# 프라이빗 API 통합 토큰 (Internal Integration Secret)
NOTION_API_KEY="secret_yourNotionIntegrationTokenHere"

# 기본 아카이빙 대상 노션 데이터베이스 ID (32자리 UUID)
NOTION_DATABASE_ID="your_notion_database_id_here"

# ------------------------------------------------------------------------------
# 5. 에러 추적 및 성능 관측 (Observability & Monitoring)
# ------------------------------------------------------------------------------
# Sentry DSN (프론트엔드 런타임 크래시 및 Web Vitals 추적)
# 발급처: https://sentry.io/
VITE_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 6. 인메모리 캐시 및 분산 락 (Redis Cache - 실시간 대용량 트래픽 대비)
# ------------------------------------------------------------------------------
# 대용량 오픈카톡 메시지 유입 시 동시성 제어 및 캐시 스탬피드 방지용
REDIS_URL="redis://localhost:6379"
